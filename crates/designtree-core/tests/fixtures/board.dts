// SPDX-License-Identifier: MIT
/*
 * Test board exercising the devicetree syntax the importer supports.
 * Written in kernel style, already preprocessed (no #include).
 */

/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "DesignTree test board";
	compatible = "designtree,test-board", "designtree,test-soc";
	interrupt-parent = <&intc>;

	aliases {
		serial0 = &uart0;
		i2c0 = &{/soc/i2c@10020000};
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0 \"quoted\"\tend";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0>;
			clocks = <&clk 0>;
			operating-points-v2 = <&cpu_opp>;
		};
	};

	cpu_opp: opp-table {
		compatible = "operating-points-v2";
		opp-shared;

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <(1000 * 1000) 950000 1100000>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	osc: oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		intc: interrupt-controller@10000000 {
			compatible = "arm,gic-400";
			reg = <0x10000000 0x1000>, <0x10002000 0x2000>;
			#interrupt-cells = <3>;
			interrupt-controller;
		};

		clk: clock-controller@10010000 {
			compatible = "designtree,ccu";
			reg = <0x10010000 0x1000>;
			clocks = <&osc>;
			clock-names = "osc";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		gpio: gpio@10030000 {
			compatible = "designtree,gpio";
			reg = <0x10030000 0x400>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-line-names = "", "led", "button";
		};

		uart0: serial@10040000 {
			compatible = "ns16550a";
			reg = <0x10040000 0x100>;
			interrupts = <0 32 4>;
			clocks = <&clk 3 &clk 4>;
			clock-names = "baud", "apb";
			resets = <&clk 1>;
			status = "disabled";
		};

		i2c@10020000 {
			compatible = "designtree,i2c";
			reg = <0x10020000 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&clk 5>;
			status = "disabled";

			eeprom@50 {
				compatible = "atmel,24c02";
				reg = <0x50>;
				pagesize = /bits/ 16 <8>;
			};

			obsolete@60 {
				compatible = "vendor,old";
				reg = <0x60>;
			};
		};

		pcie@10050000 {
			compatible = "designtree,pcie";
			reg = <0x10050000 0x1000>;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &intc 0 100 4>,
					<0 0 0 2 &intc 0 101 4>;
		};

		ethernet@10060000 {
			compatible = "designtree,eth";
			reg = <0x10060000 0x1000>;
			local-mac-address = [02 00 00 12 34 56];
			label = "eth", <1>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			gpios = <&gpio 1 0>;
			linux,default-trigger = "heartbeat";
		};
	};

	unwanted {
		compatible = "vendor,unwanted";
	};
};

&uart0 {
	status = "okay";
};

&{/soc/i2c@10020000} {
	status = "okay";
	clock-frequency = <400000>;
	/delete-node/ obsolete@60;
};

&clk {
	assigned-clocks = <&clk 3>;
	assigned-clock-rates = <48000000>;
	/delete-property/ clock-names;
};

/delete-node/ &{/unwanted};
