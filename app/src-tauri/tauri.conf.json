{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesignTree",
  "version": "0.1.0",
  "identifier": "io.github.maurilan91.designtree",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "cargo build --release -p designtree-cli"
  },
  "app": {
    "windows": [
      {
        "title": "DesignTree",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Build Linux devicetrees on a node canvas",
    "longDescription": "A graphical editor for Linux devicetrees: nodes on a canvas, wired together, with the element library built from the binding schemas of a local Linux kernel checkout. Imports existing board files and exports .dts and .dtb.",
    "copyright": "Copyright (c) Maurizio Lanza",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "device-tree-compiler"
        ],
        "files": {
          "/usr/bin/designtree": "../../target/release/designtree",
          "/usr/share/metainfo/io.github.maurilan91.designtree.metainfo.xml": "../../packaging/linux/io.github.maurilan91.designtree.metainfo.xml",
          "/usr/share/designtree/examples": "../../examples"
        }
      },
      "rpm": {
        "depends": [
          "dtc"
        ],
        "files": {
          "/usr/bin/designtree": "../../target/release/designtree",
          "/usr/share/metainfo/io.github.maurilan91.designtree.metainfo.xml": "../../packaging/linux/io.github.maurilan91.designtree.metainfo.xml",
          "/usr/share/designtree/examples": "../../examples"
        }
      }
    }
  },
  "mainBinaryName": "designtree-app"
}
